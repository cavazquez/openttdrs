# Generated by Cargo
# will have compiled files and executables
debug
target
# CARGO_TARGET_DIR aislado (agente/Cursor); no versionar
target-agent

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Código de referencia (no versionar el clone completo)
/reference/openttd-upstream/
/reference/ecosystem/

# Assets descargados por los scripts (gráficos y sonidos)
/assets/*
!/assets/sounds/
/assets/sounds/*
!/assets/sounds/*.wav
!/assets/music/
/assets/music/*
!/assets/music/*.ogg
# Texture atlas empaquetado (gen_tile_atlas.py); PNGs versionados para jugar sin descargar tiles/
!/assets/opengfx/
/assets/opengfx/*
!/assets/opengfx/atlas/
/assets/opengfx/atlas/*
!/assets/opengfx/atlas/*.png
/assets/maps/*.ottdmap
/.downloads/

# Python cache
**/__pycache__/

.codex
*.json
# Fixtures golden versionados (CI los necesita; se regeneran con scripts/)
!crates/*/tests/fixtures/**/*.json
!tests/fixtures/**/*.json
# Manifiesto pin OpenTTD (#109)
!docs/parity/openttd-reference.json
# Manifiesto de artefactos visuales por familia (#297).
!docs/parity/screenshots/window-regression.json
!docs/parity/screenshots/window-regression/**/sidecar.json
!scripts/ci_python_manifest.json
!scripts/generated_tables_manifest.json

# Prefijo local de deps / baseset para build dedicated OpenTTD (#110)
/.deps/

# Partidas JSON (F5/F9); por defecto bajo save/
/save/

# Cobertura local (cargo llvm-cov / ./scripts/check.sh cov)
/lcov.info
/htmlcov/
/fuzz/artifacts/
/fuzz/corpus/
/dist/

# Logs crudos de ./scripts/bench_baseline.sh (#116); se versiona latest.md
crates/openttdrs-core/benches/baselines/raw-*/

# Volcados accidentales (p. ej. /proc, stderr redirigido)
/sys
